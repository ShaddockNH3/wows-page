---
import Base from "../layouts/Base.astro";
import profile from "../data/profile.json";
import ships from "../data/ships.json";
import { pct, num, relative, wrGrade, typeVar } from "../utils/format";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const p = profile.pvp;

const types = [...new Set(ships.map((s) => s.type))].map((t) => ({
	key: t,
	label: ships.find((s) => s.type === t)?.typeLabel ?? t,
	color: typeVar(t),
}));
const tiers = [...new Set(ships.map((s) => s.tier))].sort((a, b) => a - b);
---

<Base title="舰船战绩" description={`${profile.nickname} 的逐船战绩`}>
	<div class="container">
		<header style="padding:3.2rem 0 1.6rem">
			<span class="hero-badge">{profile.realmLabel} · {profile.nickname}</span>
			<h1
				style="margin:.7rem 0 .3rem;font-size:clamp(1.9rem,4vw,2.6rem);font-weight:800;letter-spacing:-.02em"
			>
				舰船战绩
			</h1>
			<p class="hero-sub">
				<span>{ships.length} 艘出过海的船</span>
				<span class="dot-sep"></span>
				<span>{num(p.battles)} 场随机战</span>
				<span class="dot-sep"></span>
				<span>胜率 {pct(p.winrate)}</span>
			</p>
		</header>

		<div class="toolbar">
			<label class="search-box">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m16.2 16.2 4 4"></path>
				</svg>
				<input
					type="search"
					id="q"
					placeholder="搜索船名（中文 / English）"
					autocomplete="off"
					aria-label="搜索船名"
				/>
			</label>

			<div class="select-wrap">
				<select id="tier" aria-label="按等级筛选">
					<option value="">全部等级</option>
					{tiers.map((t) => <option value={t}>Tier {t}</option>)}
				</select>
			</div>

			<div class="select-wrap">
				<select id="sort" aria-label="排序方式">
					<option value="battles:desc">场次最多</option>
					<option value="winrate:desc">胜率最高</option>
					<option value="damage:desc">场均伤害最高</option>
					<option value="frags:desc">场均击杀最高</option>
					<option value="survival:desc">生存率最高</option>
					<option value="last:desc">最近出战</option>
					<option value="tier:desc">等级最高</option>
				</select>
			</div>
		</div>

		<div class="toolbar" style="margin-top:-.5rem">
			<div class="chips" id="types">
				<button class="chip" type="button" data-type="" aria-pressed="true">全部</button>
				{
					types.map((t) => (
						<button class="chip" type="button" data-type={t.key} aria-pressed="false">
							<span
								style={`display:inline-block;width:.45rem;height:.45rem;border-radius:2px;background:${t.color};margin-right:.35rem`}
							/>
							{t.label}
						</button>
					))
				}
			</div>
			<span class="result-count" id="count" style="margin-left:auto">
				{ships.length} 艘
			</span>
		</div>

		<div class="table-wrap">
			<table class="ships" id="table">
				<thead>
					<tr>
						<th>舰船</th>
						<th data-sort="battles" aria-sort="descending">场次</th>
						<th data-sort="winrate">胜率</th>
						<th data-sort="damage">场均伤害</th>
						<th data-sort="frags">场均击杀</th>
						<th data-sort="survival">生存率</th>
						<th data-sort="xp">场均经验</th>
						<th data-sort="last">最后出战</th>
					</tr>
				</thead>
				<tbody>
					{
						ships.map((s) => (
							<tr
								id={`ship-${s.shipId}`}
								data-search={`${s.name} ${s.nameEn}`.toLowerCase()}
								data-type={s.type}
								data-tier={s.tier}
								data-battles={s.battles}
								data-winrate={s.winrate}
								data-damage={s.avgDamage}
								data-frags={s.avgFrags}
								data-survival={s.survival}
								data-xp={s.avgXp}
								data-last={s.lastBattleAt}
							>
								<td class="ship-cell">
									<div class="ship-cell-inner">
										<span class="tier" data-tier={s.tier} style="margin-left:.1rem">
											{s.tier}
										</span>
										{s.image && <img src={s.image} alt="" loading="lazy" decoding="async" />}
										<span class="ship-cell-name">
											<b>{s.name}</b>
											<span>
												{s.typeLabel} · {s.nationLabel}
												{s.premium ? " · 金币" : ""}
											</span>
										</span>
									</div>
								</td>
								<td>{num(s.battles)}</td>
								<td>
									<span class="wr" data-grade={wrGrade(s.winrate)}>
										<span class="wr-bar">
											<i style={`width:${Math.min(100, s.winrate * 100)}%`} />
										</span>
										<b>{pct(s.winrate)}</b>
									</span>
								</td>
								<td>{num(s.avgDamage)}</td>
								<td>{s.avgFrags.toFixed(2)}</td>
								<td>{pct(s.survival)}</td>
								<td>{num(s.avgXp)}</td>
								<td style="color:var(--text-faint)">{relative(s.lastBattleAt)}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<div class="empty" id="empty" hidden>
			<strong>没有符合条件的船</strong>
			换个关键词，或者把筛选清空试试
		</div>

		<p class="section-hint" style="margin-top:1.5rem">
			点击表头可切换排序。胜率颜色：绿 ≥52% · 青 52-58% · 黄 46-52% · 红 &lt;46%。
		</p>
	</div>
</Base>

<script>
	const tbody = document.querySelector<HTMLElement>("#table tbody")!;
	const rows = [...tbody.querySelectorAll<HTMLTableRowElement>("tr")];
	const q = document.getElementById("q") as HTMLInputElement;
	const tierSel = document.getElementById("tier") as HTMLSelectElement;
	const sortSel = document.getElementById("sort") as HTMLSelectElement;
	const typeBox = document.getElementById("types")!;
	const count = document.getElementById("count")!;
	const empty = document.getElementById("empty")!;
	const table = document.getElementById("table")!;

	let activeType = "";
	let sortKey = "battles";
	let sortDir: 1 | -1 = -1;

	function apply() {
		const term = q.value.trim().toLowerCase();
		const tier = tierSel.value;
		let shown = 0;

		for (const row of rows) {
			const ok =
				(!term || row.dataset.search!.includes(term)) &&
				(!activeType || row.dataset.type === activeType) &&
				(!tier || row.dataset.tier === tier);
			row.hidden = !ok;
			if (ok) shown++;
		}

		count.textContent = `${shown} 艘`;
		table.parentElement!.hidden = shown === 0;
		empty.hidden = shown !== 0;
	}

	function sortBy(key: string, dir: 1 | -1) {
		const sorted = [...rows].sort((a, b) => {
			const av = Number(a.dataset[key] ?? 0);
			const bv = Number(b.dataset[key] ?? 0);
			return (av - bv) * dir;
		});
		for (const row of sorted) tbody.appendChild(row);
	}

	q.addEventListener("input", apply);
	tierSel.addEventListener("change", apply);

	typeBox.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".chip");
		if (!btn) return;
		for (const chip of typeBox.querySelectorAll<HTMLButtonElement>(".chip")) {
			chip.setAttribute("aria-pressed", String(chip === btn));
		}
		activeType = btn.dataset.type ?? "";
		apply();
	});

	sortSel.addEventListener("change", () => {
		const [key, dir] = sortSel.value.split(":");
		sortKey = key;
		sortDir = dir === "asc" ? 1 : -1;
		sortBy(sortKey, sortDir);
	});

	for (const th of table.querySelectorAll<HTMLTableCellElement>("th[data-sort]")) {
		th.addEventListener("click", () => {
			const key = th.dataset.sort!;
			sortDir = sortKey === key ? ((sortDir * -1) as 1 | -1) : -1;
			sortKey = key;
			for (const other of table.querySelectorAll("th[data-sort]")) {
				other.removeAttribute("aria-sort");
			}
			th.setAttribute("aria-sort", sortDir === -1 ? "descending" : "ascending");
			sortBy(key, sortDir);
		});
	}

	// 从首页带 #ship-xxx 跳进来时，直接定位那艘船
	if (location.hash.startsWith("#ship-")) {
		const target = document.querySelector(location.hash);
		if (target) {
			target.scrollIntoView({ block: "center", behavior: "smooth" });
			target.animate(
				[
					{ background: "var(--primary-soft)" },
					{ background: "transparent" },
				],
				{ duration: 1800, easing: "ease-out" },
			);
		}
	}
</script>
