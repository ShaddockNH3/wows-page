---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="找不到页面">
	<div class="container" style="padding:6rem 0;text-align:center">
		<p style="font-size:4.5rem;font-weight:800;line-height:1;margin:0;letter-spacing:-.04em;color:var(--wows-primary-strong)">
			404
		</p>
		<p style="color:var(--wows-text-muted);margin:.8rem 0 2rem">
			这条航线上没有你要找的东西。
		</p>
		<a
			href={`${base}/`}
			style="display:inline-block;padding:.6rem 1.3rem;border-radius:999px;background:var(--wows-primary);color:#fff;font-size:.88rem;font-weight:600"
		>
			回到港口
		</a>
	</div>
</Base>
