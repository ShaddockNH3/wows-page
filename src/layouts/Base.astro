---
import { siteConfig, themes } from "../config";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : `${siteConfig.title} · ${siteConfig.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const paletteCss = Object.entries(themes)
	.map(([key, t]) => `:root[data-theme="${key}"]{--hue:${t.hue}}`)
	.join("");
---

<!doctype html>
<html lang="zh-CN" data-theme={siteConfig.defaultTheme}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />

		<style is:inline set:html={paletteCss}></style>

		<script is:inline>
			// 在样式生效前定下配色，避免闪一下
			(() => {
				const root = document.documentElement;
				const q = new URLSearchParams(location.search);
				const palette = q.get("palette") || localStorage.getItem("wows-palette");
				if (palette) root.dataset.theme = palette;

				const mode = q.get("theme") || localStorage.getItem("wows-theme") || "system";
				const dark =
					mode === "dark" ||
					(mode === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
				if (dark) root.classList.add("dark");
			})();
		</script>
	</head>
	<body>
		<div class="wows-scope">
			<slot />
		</div>
	</body>
</html>
